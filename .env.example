# Variáveis de ambiente — UAIdea Agência
#
# Copie este arquivo para .env.local e preencha os valores reais.
# Nunca commitar .env.local nem .env — apenas este .env.example
# (o .gitignore já bloqueia .env* e libera só este arquivo).

# --- Formulário de contato — Server Action de envio por Gmail ---
# Consumidas por src/lib/adapters/gmail-mailer.ts. Sem as duas, a Server
# Action falha ao enviar (erro tratado — mensagem genérica no cliente,
# stack trace só no log do servidor). Como testar sem enviar e-mail de
# verdade: ver README.md.

# Conta Gmail que envia o e-mail de lead (para uaideamg@gmail.com) e a
# confirmação para quem preencheu o formulário.
GMAIL_USER=

# Senha de app do Google, não a senha normal da conta — gerada em
# https://myaccount.google.com/apppasswords. Exige verificação em duas
# etapas ativa na conta.
GMAIL_APP_PASSWORD=

# Com "true", o formulário de contato não envia e-mail nenhum — só
# imprime os dois e-mails (lead + confirmação) no terminal. Útil pra
# testar o fluxo inteiro em dev sem gastar cota do Gmail nem configurar
# credencial. Nunca deixar "true" em produção.
MAILER_DRY_RUN=true

# --- Alerta de falha de envio — src/lib/adapters/discord-alerter.ts ---
# Opcional. Se o envio pelo Gmail falhar de verdade (fora do dry-run), o
# visitante já vê um erro na tela — mas a agência só ficaria sabendo
# olhando o log do servidor. Preenchendo isso, toda falha real dispara
# um aviso num canal do Discord, independente do Gmail. Sem esta env, cai
# num no-op silencioso (só o log continua). Como gerar: no Discord,
# Configurações do canal → Integrações → Webhooks → Novo Webhook → Copiar
# URL do Webhook.
DISCORD_WEBHOOK_URL=

# --- URL base do site — src/config/bases.ts ---
# Usada em metadataBase (og:image, canonical) e em qualquer URL absoluta
# que o site precisar montar. Sem esta env, cai no domínio do deploy da
# Vercel (VERCEL_URL) e, em dev, em http://localhost:3000 — não é
# obrigatória, mas defina o domínio final assim que ele existir.
NEXT_PUBLIC_SITE_URL=
